[Unit]
Description=SwitchBot dashboard API (FastAPI/Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# IMPORTANT:
User=user
WorkingDirectory=/home/user/workspace/sensors
Environment=PYTHONUNBUFFERED=1

# Run Uvicorn in the foreground so systemd can supervise it.
# Bind to 0.0.0.0 to make it reachable from your LAN.
ExecStart=/home/user/workspace/sensors/venv/bin/uvicorn src.api.dashboard_api:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
